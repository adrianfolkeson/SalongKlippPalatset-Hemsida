---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
---

<!doctype html>
<html lang="sv" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F5F2EC" />
    <meta name="generator" content={Astro.generator} />

    {site.noindex && <meta name="robots" content="noindex, nofollow" />}

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/cormorant-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jost-latin-wght-normal.woff2"
      crossorigin
    />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only rounded-[var(--radius-md)] focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]
             focus:bg-ink focus:px-5 focus:py-3 focus:text-surface"
    >
      Hoppa till innehåll
    </a>

    <span id="top" class="sr-only"></span>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      // Scroll reveal — motion-safe, and a no-op when reduced motion is set.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');

      const revealNow = (el: Element) => el.classList.add('is-revealed');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach(revealNow);
      } else {
        // Anything already inside the first viewport reveals on load — the
        // observer's bottom margin must never be able to strand it.
        const pending: Element[] = [];
        targets.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) revealNow(el);
          else pending.push(el);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        pending.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
