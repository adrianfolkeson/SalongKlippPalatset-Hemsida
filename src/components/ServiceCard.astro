---
import FillIn from './FillIn.astro';
import { salons, formatFrom, type Service } from '../lib/site';

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;

// The "ordinary price" note only means something once a price is actually shown.
const hasPrice = salons.some((salon) => {
  const price = service.prices[salon.id];
  return price.confirmed && price.from !== null;
});
---

<article
  class="group relative flex h-full flex-col rounded-[var(--radius-lg)] border border-line bg-surface p-7
         transition-[transform,border-color,box-shadow] duration-500 [transition-timing-function:var(--ease-calm)]
         motion-safe:hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_18px_40px_-28px_rgba(35,32,28,0.35)] sm:p-8"
  data-reveal
  style={`--reveal-delay: ${index * 90}ms;`}
>
  <span aria-hidden="true" class="hairline-accent w-10 transition-[width] duration-500 group-hover:w-16"></span>

  <h3 class="mt-6 text-h3">{service.name}</h3>
  <p class="mt-3 text-body text-ink-muted">{service.description}</p>

  <!-- Prices are per salon, and always the ORDINARY price — campaigns live on
       Bokadirekt, which each row links to. -->
  <dl class="mt-6 flex flex-col gap-3 border-t border-line pt-6">
    {
      salons.map((salon) => {
        const price = service.prices[salon.id];
        return (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <dt class="text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">
              {salon.name}
            </dt>
            <dd class="font-display text-[1.125rem] font-semibold text-ink">
              {price.confirmed && price.from !== null ? (
                formatFrom(price.from)
              ) : (
                <FillIn note={`Pris för ${service.name} i ${salon.name} — ${price.source ?? 'hämta ordinarie pris, inte kampanjpris'}`}>
                  <span class="text-body font-sans font-normal text-ink-muted">Pris</span>
                </FillIn>
              )}
            </dd>
          </div>
        );
      })
    }
  </dl>

  {hasPrice && <p class="mt-4 text-[0.8125rem] leading-relaxed text-ink-muted">Ordinarie pris.</p>}

  <div class="mt-auto pt-6">
    <p class="text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">
      Se alla priser och boka
    </p>
    <ul class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        salons.map((salon) => (
          <li>
            <a
              href={salon.bookingUrl.value}
              target="_blank"
              rel="noopener noreferrer"
              class="tap group/link inline-flex items-center gap-2 text-body text-ink hover:text-accent-deep"
            >
              <span
                aria-hidden="true"
                class="h-px w-5 bg-accent transition-[width] duration-300 group-hover/link:w-8"
              />
              {salon.name}
              <span class="sr-only">— alla priser hos Bokadirekt (öppnas i ny flik)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>
