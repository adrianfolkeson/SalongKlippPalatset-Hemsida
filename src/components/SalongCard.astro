---
import Button from './Button.astro';
import FillIn from './FillIn.astro';
import { telHref, type Salon } from '../lib/site';

interface Props {
  salon: Salon;
  index?: number;
}

const { salon, index = 0 } = Astro.props;

const dayNames = ['', 'mån', 'tis', 'ons', 'tors', 'fre', 'lör', 'sön'];
const formatDays = (days: number[]) =>
  days.length > 1 ? `${dayNames[days[0]]}–${dayNames[days[days.length - 1]]}` : dayNames[days[0]];
---

<article
  id={`salong-${salon.id}`}
  class="group flex h-full scroll-mt-28 flex-col rounded-[var(--radius-lg)] border border-line bg-surface
         p-7 transition-[border-color,box-shadow] duration-500 [transition-timing-function:var(--ease-calm)]
         hover:border-accent/60 hover:shadow-[0_20px_44px_-30px_rgba(35,32,28,0.4)] sm:p-9"
  data-reveal
  style={`--reveal-delay: ${index * 120}ms;`}
>
  <header>
    <p class="text-eyebrow font-medium uppercase tracking-[0.14em] text-accent-deep">Salong</p>
    <h3 class="mt-2 font-display text-[2rem] font-semibold leading-none">{salon.name}</h3>
    <span aria-hidden="true" class="hairline-accent mt-5 w-12"></span>
  </header>

  <dl class="mt-7 flex flex-col gap-5 text-body">
    <div>
      <dt class="text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">Adress</dt>
      <dd class="mt-1.5">
        {
          salon.street.confirmed && salon.postalCode.confirmed ? (
            <span>
              {salon.street.value}, {salon.postalCode.value} {salon.city}
            </span>
          ) : (
            <FillIn note={`Adress ${salon.name} — ${salon.street.source ?? 'obekräftad källa'}`}>
              <span>
                {salon.street.value}, {salon.postalCode.value} {salon.city}
              </span>
            </FillIn>
          )
        }
      </dd>
    </div>

    <div>
      <dt class="text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">Öppettider</dt>
      <dd class="mt-1.5">
        {
          salon.hours.confirmed && salon.hours.value ? (
            <ul class="flex flex-col gap-1">
              {salon.hours.value.map((row) => (
                <li class="flex items-baseline justify-between gap-6 tabular-nums">
                  <span class="text-ink-muted">{formatDays(row.days)}</span>
                  <span aria-hidden="true" class="hairline mt-2 min-w-6 flex-1" />
                  <span>
                    {row.opens}–{row.closes}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <FillIn kind="fyll-i" note={`Öppettider ${salon.name} — ${salon.hours.source ?? 'saknas'}`}>
              <span class="text-ink-muted">Öppettider hämtas från salongen</span>
            </FillIn>
          )
        }
        {salon.hoursNote && (
          <p class="mt-2 text-[0.8125rem] leading-relaxed text-ink-muted">{salon.hoursNote}</p>
        )}
      </dd>
    </div>

    <div>
      <dt class="text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">Telefon</dt>
      <dd class="mt-1.5">
        {
          salon.phone.confirmed ? (
            <a class="tap inline-flex items-center hover:text-accent-deep" href={telHref(salon.phone.value)}>
              {salon.phone.value}
            </a>
          ) : (
            <FillIn note={`Telefon ${salon.name} — ${salon.phone.source ?? 'obekräftad källa'}`}>
              <a class="tap inline-flex items-center hover:text-accent-deep" href={telHref(salon.phone.value)}>
                {salon.phone.value}
              </a>
            </FillIn>
          )
        }
      </dd>
    </div>
  </dl>

  <div class="mt-auto pt-8">
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href={salon.bookingUrl.value} external class="flex-1">
        Boka tid i {salon.name}
      </Button>
      <Button href={salon.mapUrl.value} external variant="secondary" class="flex-1">Hitta hit</Button>
    </div>

    {
      !salon.bookingUrl.confirmed && (
        <p class="mt-3 text-[0.8125rem] leading-relaxed text-ink-muted">
          <FillIn note={salon.bookingUrl.source ?? 'bekräfta bokningslänk'}>
            <span>Länken går till salongens befintliga Bokadirekt-profil.</span>
          </FillIn>
        </p>
      )
    }
  </div>
</article>
