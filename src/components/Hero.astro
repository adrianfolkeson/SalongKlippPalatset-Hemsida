---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import TrustStrip from './TrustStrip.astro';
import { salons, features } from '../lib/site';

/**
 * Text on the calm ivory field, photo in a contained frame beside it.
 *
 * The delivered original is 469×569. Displayed at ~26rem it sits close to its
 * native size and reads sharp; stretched full-bleed it does not. Until a
 * high-resolution original arrives, the frame stays small — and
 * features.heroPhoto = false drops it altogether for a text-only hero.
 */
const heroFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroImage = features.heroPhoto ? Object.values(heroFiles)[0]?.default : undefined;
const heroWidths = heroImage
  ? [360, 480, 640].filter((w) => w < heroImage.width).concat(heroImage.width)
  : [];
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden bg-paper
         pt-28 sm:pt-32"
  style="padding-bottom: calc(3rem + env(safe-area-inset-bottom));"
>
  <!-- Quiet tonal field so the ivory never reads as flat white -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background:
      radial-gradient(75% 55% at 82% 10%, rgba(233,237,227,0.8) 0%, rgba(233,237,227,0) 62%),
      radial-gradient(65% 55% at 6% 94%, rgba(228,223,213,0.6) 0%, rgba(228,223,213,0) 62%);"
  >
  </div>

  <Container class="relative">
    <div
      class={`grid items-center gap-10 ${heroImage ? 'lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16' : ''}`}
    >
      <div class={heroImage ? 'order-2 lg:order-1' : ''}>
        <Eyebrow class="mb-6" data-reveal>Dam &amp; herr · Partille &amp; Mölnlycke</Eyebrow>

        <h1
          class={`font-display font-semibold leading-[1.03] text-ink ${
            heroImage
              ? 'text-[clamp(2.5rem,5vw,4.5rem)]'
              : 'text-[clamp(2.75rem,6.5vw,5.75rem)]'
          }`}
          data-reveal
          style="--reveal-delay: 80ms;"
        >
          Klippning och färg med omsorg.
        </h1>

        <p
          class="mt-6 max-w-[44ch] text-body-lg text-ink-muted"
          data-reveal
          style="--reveal-delay: 160ms;"
        >
          En etablerad dam- och herrsalong med två salonger — klippning, färg och personlig
          service i en fräsch, trivsam miljö.
        </p>

        <div
          class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
          data-reveal
          style="--reveal-delay: 240ms;"
        >
          <Button href="#boka" size="lg">Boka tid</Button>
          <Button href="#salonger" variant="secondary" size="lg">Våra salonger</Button>
        </div>

        <!-- Signature: the two salons -->
        <ul
          class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2"
          data-reveal
          style="--reveal-delay: 320ms;"
        >
          {
            salons.map((salon, i) => (
              <li class="flex items-center gap-6">
                {i > 0 && <span aria-hidden="true" class="h-6 w-px bg-accent" />}
                <a
                  href={`#salong-${salon.id}`}
                  class="tap inline-flex items-center font-display text-[1.375rem] font-semibold text-ink
                         transition-colors duration-300 hover:text-accent-deep lg:text-[1.5rem]"
                >
                  {salon.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        heroImage && (
          <figure
            class="order-1 mx-auto w-full max-w-[17.5rem] sm:max-w-[21rem] lg:order-2 lg:mx-0 lg:w-[26rem] lg:max-w-none"
            data-reveal
            style="--reveal-delay: 120ms;"
          >
            <div class="relative">
              <span
                aria-hidden="true"
                class="absolute -left-4 top-6 hidden h-24 w-px bg-accent lg:block"
              />
              <Image
                src={heroImage}
                alt="Nyfärgat hår med ljusa slingor, fönat i mjuka lager."
                widths={heroWidths}
                sizes="(min-width: 1024px) 416px, (min-width: 640px) 352px, 320px"
                quality={82}
                loading="eager"
                fetchpriority="high"
                class="aspect-[4/5] w-full rounded-[var(--radius-lg)] object-cover object-[52%_22%]
                       shadow-[0_36px_72px_-52px_rgba(35,32,28,0.6)]"
              />
            </div>
            <figcaption class="mt-4 flex items-center gap-3 text-eyebrow font-medium uppercase tracking-[0.14em] text-ink-muted">
              <span aria-hidden="true" class="h-px w-8 bg-accent" />
              Färg &amp; slingor
            </figcaption>
          </figure>
        )
      }
    </div>

    <TrustStrip class="mt-12 lg:mt-14" data-reveal style="--reveal-delay: 400ms;" />
  </Container>
</section>
