---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import TrustStrip from './TrustStrip.astro';
import { salons } from '../lib/site';

/**
 * Full-bleed hero photo with LOCALISED scrims: the copy carries its own
 * readable surface, and the rest of the photo is left alone. Alphas mirror
 * scripts/photo-contrast.mjs — change one, re-run `npm run contrast:photos`.
 */
const heroFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);
const heroImage = Object.values(heroFiles)[0]?.default;
const heroWidths = heroImage
  ? [768, 1280, 1920, 2560].filter((w) => w < heroImage.width).concat(heroImage.width)
  : [];
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-accent-soft
         pt-28 sm:pt-32"
  style="padding-bottom: calc(3rem + env(safe-area-inset-bottom));"
>
  <!-- Media -->
  <div class="absolute inset-0 -z-20">
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt=""
          widths={heroWidths}
          sizes="100vw"
          quality={70}
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-[52%_8%]"
        />
      ) : (
        <div
          aria-hidden="true"
          class="h-full w-full"
          style="background: linear-gradient(160deg, #efece4 0%, #e4e8dd 48%, #d9d4c8 100%);"
        />
      )
    }
  </div>

  <!-- Mobile: the copy sits on an ivory card, the photo runs free above it -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 top-[19%] -z-10 rounded-t-[var(--radius-lg)] border-t border-line/70
           bg-paper/88 backdrop-blur-[3px] md:hidden"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-[13%] -z-10 h-[6%] md:hidden"
    style="background: linear-gradient(to bottom, rgba(245,242,236,0) 0%, rgba(245,242,236,0.88) 100%);"
  >
  </div>

  <!-- Desktop: side scrim behind the copy column, photo untouched on the right -->
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 hidden md:block"
    style="background:
      linear-gradient(to right, rgba(245,242,236,0.94) 0%, rgba(245,242,236,0.90) 32%, rgba(245,242,236,0.70) 46%, rgba(245,242,236,0.24) 60%, rgba(245,242,236,0) 70%);"
  >
  </div>

  <!-- Desktop: thin bottom band so the TrustStrip stays legible edge to edge -->
  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 -z-10 hidden h-[34%] md:block"
    style="background:
      linear-gradient(to top, rgba(245,242,236,0.92) 0%, rgba(245,242,236,0.88) 55%, rgba(245,242,236,0.35) 85%, rgba(245,242,236,0) 100%);"
  >
  </div>

  <Container class="relative">
    <div class="max-w-[46rem]">
      <Eyebrow tone="ink" class="mb-6" data-reveal>Dam &amp; herr · Partille &amp; Mölnlycke</Eyebrow>

      <h1
        class="font-display text-[clamp(2.5rem,5.4vw,4.75rem)] font-semibold leading-[1.03] text-ink"
        data-reveal
        style="--reveal-delay: 80ms;"
      >
        Klippning och färg med omsorg.
      </h1>

      <p
        class="mt-6 max-w-[42ch] text-body-lg text-ink"
        data-reveal
        style="--reveal-delay: 160ms;"
      >
        En etablerad dam- och herrsalong med två salonger — klippning, färg och personlig
        service i en fräsch, trivsam miljö.
      </p>

      <div
        class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        data-reveal
        style="--reveal-delay: 240ms;"
      >
        <Button href="#boka" size="lg">Boka tid</Button>
        <Button href="#salonger" variant="secondary" size="lg">Våra salonger</Button>
      </div>

      <!-- Signature: the two salons -->
      <ul
        class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2"
        data-reveal
        style="--reveal-delay: 320ms;"
      >
        {
          salons.map((salon, i) => (
            <li class="flex items-center gap-6">
              {i > 0 && <span aria-hidden="true" class="h-6 w-px bg-accent" />}
              <a
                href={`#salong-${salon.id}`}
                class="tap inline-flex items-center font-display text-[1.375rem] font-semibold text-ink
                       transition-colors duration-300 hover:text-accent-deep lg:text-[1.5rem]"
              >
                {salon.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <TrustStrip class="mt-12 lg:mt-14" data-reveal style="--reveal-delay: 400ms;" />
  </Container>
</section>
